find_package(Threads REQUIRED)
set(PROJECT_ROOT "${CMAKE_SOURCE_DIR}")
set(CORE "${CMAKE_CURRENT_SOURCE_DIR}/src/display")
set(PREPROCESS "${CMAKE_CURRENT_SOURCE_DIR}/src/preprocess")
set(TESTS "${PROJECT_ROOT}/tests/native")
include_directories(src/app src/common src/input src/input/nexmon src/inference
    src/pose src/display src/io src/diagnostics src/compat "${PREPROCESS}" "${PROJECT_ROOT}")
add_library(pose_postprocess src/pose/postprocess.cpp src/pose/single_person.cpp)
target_include_directories(pose_postprocess PUBLIC src/pose)
set(DEMO_SOURCES src/app/main.cpp src/io/io.cpp src/diagnostics/journal.cpp
    src/input/csi.cpp src/input/dataset.cpp src/input/nexmon/ingress.cpp
    src/input/nexmon/adaptive_ingress.cpp src/input/nexmon/pcap_stream.cpp
    "${PREPROCESS}/preprocess.cpp")
option(POSE180_BUILD_SDK "Build the qualified ARM64 SDK owner" OFF)
if(POSE180_BUILD_SDK)
    find_package(icraft-hostbackend 3.39.0.0 EXACT REQUIRED)
    find_package(icraft-zg330backend 3.39.0.0 EXACT REQUIRED)
    add_executable(pose180_demo ${DEMO_SOURCES} src/inference/runtime.cpp
        "${CORE}/hdmi_renderer.cpp" "${CORE}/projection.cpp" "${CORE}/hdmi_output.cpp"
        "${PREPROCESS}/pl_preprocess.cpp" "${PREPROCESS}/polar_finish.cpp")
    target_compile_definitions(pose180_demo PRIVATE POSE180_DEMO_SDK=1
        POSE180_DEMO_PL_CSI=1 POSE180_DEMO_PL_OVERLAY=1 POSE180_DEMO_PROBE_FREE=1
        POSE180_DEMO_PROBE_FREE_DRAIN=1 POSE180_DEMO_PL_FILTER=1)
    target_include_directories(pose180_demo BEFORE PRIVATE "${CORE}")
    target_compile_options(pose180_demo PRIVATE -Wall -Wextra -Wpedantic -ffp-contract=off)
    target_link_options(pose180_demo PRIVATE -Wl,--no-as-needed)
    target_link_libraries(pose180_demo PRIVATE Icraft::HostBackend Icraft::ZG330Backend Threads::Threads)
    target_link_libraries(pose180_demo PRIVATE pose_postprocess)
else()
    add_executable(pose180_demo_mock ${DEMO_SOURCES})
    target_compile_options(pose180_demo_mock PRIVATE -Wall -Wextra -Wpedantic -ffp-contract=off)
    target_link_libraries(pose180_demo_mock PRIVATE Threads::Threads)
    target_link_libraries(pose180_demo_mock PRIVATE pose_postprocess)
    foreach(name postprocess single_person)
        add_executable(${name}_tests "${TESTS}/${name}_tests.cpp")
        target_link_libraries(${name}_tests PRIVATE pose_postprocess)
        add_test(NAME ${name} COMMAND ${name}_tests)
    endforeach()
    add_executable(buffer_tests "${TESTS}/buffer_tests.cpp")
    target_link_libraries(buffer_tests PRIVATE Threads::Threads)
    add_test(NAME buffer COMMAND buffer_tests)
    foreach(name renderer overlay)
        add_executable(${name}_tests "${TESTS}/${name}_tests.cpp" "${CORE}/hdmi_renderer.cpp" "${CORE}/projection.cpp")
        if(name STREQUAL "overlay")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/test-output/overlay")
            add_test(NAME overlay COMMAND overlay_tests "${CMAKE_BINARY_DIR}/test-output/overlay")
        else()
            add_test(NAME renderer COMMAND renderer_tests)
        endif()
    endforeach()
    if(UNIX)
        add_executable(release_guard_tests "${TESTS}/release_guard_tests.cpp")
        add_test(NAME release_guard COMMAND release_guard_tests)
        add_executable(hdmi_resource_tests "${TESTS}/hdmi_resource_tests.cpp" "${CORE}/hdmi_output.cpp")
        target_include_directories(hdmi_resource_tests BEFORE PRIVATE "${TESTS}/sdk_stub" "${CORE}")
        target_link_libraries(hdmi_resource_tests PRIVATE Threads::Threads)
        add_test(NAME hdmi_resource COMMAND hdmi_resource_tests)
        add_executable(journal_tests "${TESTS}/journal_tests.cpp" src/diagnostics/journal.cpp)
        target_link_libraries(journal_tests PRIVATE Threads::Threads)
        add_test(NAME journal COMMAND ${CMAKE_COMMAND} "-DTEST=$<TARGET_FILE:journal_tests>"
            -P "${PROJECT_ROOT}/cmake/run_journal_test.cmake")
    endif()
    add_executable(csi_numeric_test "${TESTS}/csi_numeric_test.cpp" "${TESTS}/polar_model.cpp"
        "${PREPROCESS}/preprocess.cpp" "${PREPROCESS}/polar_finish.cpp")
    target_include_directories(csi_numeric_test PRIVATE "${TESTS}")
    target_compile_options(csi_numeric_test PRIVATE -ffp-contract=off)
endif()
